# Local development values used by `wrangler types`.
# Copy this file to `.dev.vars` and replace placeholders as needed.

# Repo Durable Object idle cleanup threshold in minutes.
REPO_DO_IDLE_MINUTES=30

# Logging level: debug|info|warn|error.
LOG_LEVEL=debug

# Enable Repository Durable Object-owned native Git receive processing.
NATIVE_RECEIVE_CONTAINER=0

# Local goc browser session cookie sealing secret. Generate a real value with
# `openssl rand -hex 32`, then set production with
# `wrangler secret put SESSION_SECRET`; never commit a real production value.
SESSION_SECRET=local-goc-session-secret-change-me

# tessera OIDC issuer override for local dev. Production value lives in
# wrangler.jsonc.vars (https://auth.limic.dev). Loopback HTTP is allowed for
# the issuer because tessera dev runs on http://localhost:5174.
TESSERA_OIDC_ISSUER=http://localhost:5174

# tessera OIDC client credentials. These are runtime/deployment-specific.
# Production should use `wrangler secret put TESSERA_OIDC_CLIENT_SECRET` (and
# either `wrangler secret put` or env-specific vars for the client id);
# never commit a real production value to wrangler.jsonc.vars.
TESSERA_OIDC_CLIENT_ID=local-goc
TESSERA_OIDC_CLIENT_SECRET=local-goc-dev-secret-change-me

# Optional internal ingestion endpoint. Production remains disabled until this
# secret is explicitly configured with `wrangler secret put`.
INGESTION_RPC_TOKEN=local-goc-ingestion-token-change-me

# Investigation-only synchronous snapshot materializer. Leave empty outside
# disposable benchmark deployments.
SNAPSHOT_BENCHMARK_PREFIX=
SNAPSHOT_EVENT_PROBE=
