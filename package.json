{
  "name": "git-on-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:workers": "vitest run --config vitest.config.ts",
    "test:auth": "vitest run --config vitest.config.ts test/auth.worker.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "types:generate": "wrangler types --env-file .dev.vars.example",
    "typecheck": "npm run types:generate && tsc -p test/tsconfig.json --noEmit",
    "cf-typegen": "npm run types:generate",
    "db:gen": "drizzle-kit generate --config drizzle-repo-do.config.ts"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.30.3",
    "@cloudflare/vitest-pool-workers": "^0.14.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^25.5.0",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.0.0",
    "drizzle-kit": "^0.31.4",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.7.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.2",
    "wrangler": "^4.37.1"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.1",
    "highlight.js": "^11.11.1",
    "hono": "^4.12.16",
    "lucide-react": "^1.7.0",
    "marked": "^18.0.0",
    "pako": "^2.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanitize-html": "^2.17.1"
  }
}
